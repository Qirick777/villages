; Engine configuration file.
; Auto-expanding village simulation — demand-driven.
; Godot 4.7 (GDScript)

config_version=5

[application]

config/name="Villages — 자동 확장 마을 시뮬레이션"
config/description="수요(Demand) 알고리즘으로 스스로 끝없이 확장하는 마을 시뮬레이션"
run/main_scene="res://world/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

RNGService="*res://autoload/rng_service.gd"
GameClock="*res://autoload/game_clock.gd"
MapGen="*res://autoload/map_gen.gd"
Village="*res://autoload/village.gd"
RequestBroker="*res://autoload/request_broker.gd"
PressureBoard="*res://autoload/pressure_board.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true

[input]

cam_pan_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","physics_key":false,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)]
}
cam_pan_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","physics_key":false,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)]
}
cam_pan_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","physics_key":false,"key_label":0,"unicode":119,"location":0,"echo":false,"script":null)]
}
cam_pan_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","physics_key":false,"key_label":0,"unicode":115,"location":0,"echo":false,"script":null)]
}
